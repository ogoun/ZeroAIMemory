# Шаблон юнита: `zam-server service install` подставляет User/Group, WorkingDirectory,
# ExecStart, TimeoutStopSec (по qdrant.shutdown_flush_wait_ms) и ReadWritePaths (по data_dir);
# `zam-server service install --print` выводит готовый юнит. Можно установить и вручную.
[Unit]
Description=ZeroAIMemory server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zam
Group=zam
WorkingDirectory=/opt/zeroaimemory
ExecStart=/opt/zeroaimemory/zam-server serve --config /etc/zeroaimemory/config.toml
Restart=on-failure
RestartSec=3
# Сервер корректно завершается по SIGTERM. Таймаут остановки —
# max(90, ceil(qdrant.shutdown_flush_wait_ms / 1000) + 80) с: 80 с запаса на недоделанную пачку
# инференса (до 60 с), перечанковку (до 10 с) и SIGTERM Qdrant (до 10 с) плюс ожидание
# подтверждения WAL Qdrant (умолчание 14000 мс → 94 с). Обычно после записи — около 10–20 с.
# При qdrant.shutdown_flush_wait_ms = 60000 (максимум) — TimeoutStopSec=140.
KillSignal=SIGTERM
TimeoutStopSec=94
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Каталог данных (data_dir в config.toml)
ReadWritePaths=/var/lib/zeroaimemory

[Install]
WantedBy=multi-user.target
