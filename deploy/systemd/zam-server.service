[Unit]
Description=ZeroAIMemory server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zam
Group=zam
WorkingDirectory=/opt/zeroaimemory
ExecStart=/opt/zeroaimemory/zam-server serve --config /etc/zeroaimemory/config.toml
Restart=on-failure
RestartSec=3
# Сервер корректно завершается по SIGTERM. Худший случай — 90 с: воркер индексации (обычно < 1 с,
# недоделанная пачка инференса — до 60 с), перечанковка после миграции (до 10 с), ожидание
# подтверждения WAL Qdrant (qdrant.shutdown_flush_wait_ms, до 10 с), SIGTERM Qdrant (до 10 с).
# Обычно после записи — около 10–15 с.
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Каталог данных (data_dir в config.toml)
ReadWritePaths=/var/lib/zeroaimemory

[Install]
WantedBy=multi-user.target
