<!DOCTYPE html>
<html lang="ru">
<head><meta charset="utf-8"><title>ZeroAIMemory: лицензии Rust-зависимостей</title></head>
<body>
<h1>Лицензии сторонних Rust-зависимостей</h1>
<h2>Сводка</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
<h2>Тексты лицензий</h2>
<ul>
{{#each licenses}}<li id="{{id}}">
<h3>{{name}}</h3>
<h4>Используется в:</h4>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}</ul>
<pre>{{text}}</pre>
</li>
{{/each}}</ul>
</body>
</html>
